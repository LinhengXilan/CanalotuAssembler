# configuration file generated by Bochs
plugin_ctrl: voodoo=false, unmapped=false, biosdev=false, speaker=false, fw_cfg=false, acpi=false, parallel=false, serial=false, busmouse=false, e1000=false, es1370=false, gameport=false, iodebug=false, ne2k=false, sb16=false, usb_uhci=false, usb_ohci=false, usb_ehci=false, usb_xhci=false
config_interface: win32config
display_library: nogui
memory: guest=1, host=1, block_size=0
romimage: file="C:\Program Files\Bochs-3.1\BIOS-bochs-legacy", address=0x00000000, options=none, flash_data=none
vgaromimage: file="C:\Program Files\Bochs-3.1\VGABIOS-lgpl-latest.bin"
boot: floppy
floppy_bootsig_check: disabled=0
floppya: type=1_44, 1_44="D:\CanalotuAssembler\Example\8086\mov.bin", status=inserted, write_protected=0
# no floppyb
ata0: enabled=false
ata1: enabled=false
ata2: enabled=false
ata3: enabled=false
optromimage1: file=none
optromimage2: file=none
optromimage3: file=none
optromimage4: file=none
optramimage1: file=none
optramimage2: file=none
optramimage3: file=none
optramimage4: file=none
pci: enabled=0
vga: extension=none, update_freq=10, realtime=0, ddc=disabled
cpu: count=1, ips=50000000, model=i386, reset_on_triple_fault=1, cpuid_limit_winnt=0, cpuid_freq=hardware, ignore_bad_msrs=1, mwait_is_nop=0
print_timestamps: enabled=0
debugger: log=-, gui=false
magic_break: enabled=0
port_e9_hack: enabled=false, all_rings=false
iodebug: all_rings=0
private_colormap: enabled=0
clock: sync=realtime, time0=local, rtc_sync=0
# no cmosimage
log: -
logprefix: %t%e%d
debug: action=ignore
info: action=report
warn: action=warn
error: action=report
panic: action=ask
keyboard: type=at, serial_delay=150, paste_delay=100000, user_shortcut=none
mouse: type=ps2, enabled=false, toggle=ctrl+mbutton
sound: waveoutdrv=win, waveout=none, waveindrv=win, wavein=none, midioutdrv=win, midiout=none
usb_debug: type=none
